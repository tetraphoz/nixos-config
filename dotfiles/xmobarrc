Config {
    overrideRedirect = True,

    font = "Cozette 9",

    bgColor = "#111111",
    fgColor = "#bbbbbb",

    position = Bottom,

    commands = [

        -- CPU
        Run Cpu
            [ "-t", "CPU: <total>%"
            , "-L", "10"
            , "-H", "80"
            , "--low", "#88aa88"
            , "--normal", "#d8a657"
            , "--high", "#cc6666"
            ] 10,

        -- Temperature
        Run CoreTemp
            [ "--template", "Temp: <core0>°C"
            , "--Low", "50"
            , "--High", "80"
            , "--low", "#88aa88"
            , "--normal", "#d8a657"
            , "--high", "#cc6666"
            ] 15,

        -- Memory
        Run Memory
            [ "--template", "RAM: <usedratio>%"
            , "--Low", "30"
            , "--High", "80"
            , "--low", "#88aa88"
            , "--normal", "#d8a657"
            , "--high", "#cc6666"
            ] 10,

        -- Battery
        Run Battery
            [ "--template", "Bat: <left>%"
            , "--Low", "20"
            , "--High", "80"
            , "--low", "#cc6666"
            , "--normal", "#d8a657"
            , "--high", "#88aa88"

            , "--"
            , "-o", "<left>% <timeleft>"
            , "-O", "<fc=#d8a657>AC</fc>"
            , "-i", "<fc=#88aa88>Full</fc>"
            ] 30,

        -- Music
        Run MPD
            [ "-t", "<state> <artist> — <title>"
            , "--"
            , "-P", "▶"
            , "-Z", "⏸"
            , "-S", "■"
            ] 5,

        -- Clock
        Run Date
            "<fc=#8be9fd>%a %Y-%m-%d</fc>  %H:%M"
            "date"
            10,

        -- XMonad workspace/title information
        Run XMonadLog
    ],

    sepChar = "%",

    alignSep = "}{",

    template =
        " %XMonadLog% }{ %mpd%  |  CPU %cpu%  |  %coretemp%  |  %memory%  |  %battery%  |  %date% "
}
