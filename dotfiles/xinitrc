#!/usr/bin/env bash

export XDG_SESSION_TYPE=x11

# Lock when logind requests a lock or before suspend/lid sleep.
xss-lock --transfer-sleep-lock -- slock &

# Lock after 15 minutes of inactivity, except during fullscreen apps.
xidlehook --not-when-fullscreen --timer 900 'slock' '' &

dunst -b &
wmname LG3D  &

#syncthing --no-browser &

xset r rate 200 60 &
setxkbmap us altgr-intl &

#xrandr --setprovideroutputsource modesetting NVIDIA-0 #PRIME
#xrandr --setprovideroutputsource NVIDIA-G0 modesetting #Reverse PRIME

#xrandr --setprovideroffloadsink NVIDIA-0 modesetting # PRIME GPU Offload
xrandr --auto
#xrandr --dpi 142


wal -R &
ln -sf ~/.cache/wal/Colors.hs ~/.xmonad/lib/

xsettingsd &
picom &
redshift -l 25.686613:-100.316116 &

# if [ -x /usr/bin/gpg-agent ]; then
#  eval "$(/usr/bin/gpg-agent --daemon)"
# fi

[[ -f ~/.Xresources ]] && xrdb -merge ~/.Xresources

#[ ! -s ~/.config/mpd/pid ] && mpd &

polkit-gnome-authentication-agent-1 &

exec dbus-run-session xmonad
