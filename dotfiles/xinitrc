#!/usr/bin/env bash

export XDG_SESSION_TYPE=x11

# Lock when logind requests a lock or before suspend/lid sleep.
xss-lock --transfer-sleep-lock -- slock &

# Lock after 15 minutes of inactivity, except during fullscreen apps or audio playback.
# PipeWire's PulseAudio compatibility layer lets xidlehook detect active audio.
xidlehook --not-when-fullscreen --not-when-audio --timer 900 'slock' '' &

dunst -b &
wmname LG3D  &

xset r rate 200 60 &
setxkbmap us altgr-intl &

# The internal panel is on Intel, but the P52 HDMI connector is on the
# Quadro.  Attach the NVIDIA output provider to the Intel X screen before
# configuring outputs (Reverse PRIME / OutputSink).  Ly does not consume
# services.xserver.displayManager.setupCommands, so this belongs in the user
# X session rather than only in the NixOS NVIDIA module.
xrandr --setprovideroutputsource NVIDIA-G0 modesetting 2>/dev/null || true
xrandr --auto

# services.autorandr handles the initial layout and subsequent DRM hotplug
# events.  Its profiles are declared in hosts/p52/desktop.nix.
autorandr --change --default default >/dev/null 2>&1 || true

wal -R >/dev/null 2>&1 &
if [[ -f ~/.cache/wal/Colors.hs ]]; then
  ln -sfn ~/.cache/wal/Colors.hs ~/.xmonad/lib/Colors.hs
fi

xsettingsd &
picom &
redshift -l 25.686613:-100.316116 &

[[ -f ~/.Xresources ]] && xrdb -merge ~/.Xresources

"$HOME/.local/bin/polkit-agent" &

exec dbus-run-session xmonad
