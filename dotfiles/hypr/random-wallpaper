#!/usr/bin/env bash
set -euo pipefail

mapfile -d '' wallpapers < <(
  find /media/img/wallpapers -type f \
    \( -iname '*.avif' -o -iname '*.bmp' -o -iname '*.jpeg' -o -iname '*.jpg' -o -iname '*.png' -o -iname '*.webp' \) \
    -print0
)

if (( ${#wallpapers[@]} == 0 )); then
  echo "no wallpapers found in /media/img/wallpapers" >&2
  exit 1
fi

wallpaper="${wallpapers[RANDOM % ${#wallpapers[@]}]}"
for _ in {1..30}; do
  if hyprctl hyprpaper wallpaper ",$wallpaper" >/dev/null 2>&1; then
    # Generate the shared Kitty, Rofi, Dunst, and Waybar palette from this
    # wallpaper. Keep the wallpaper change successful if pywal cannot run.
    if command -v wal >/dev/null 2>&1 && wal -i "$wallpaper" -n >/dev/null 2>&1; then
      pkill -USR2 waybar 2>/dev/null || true
      dunstctl reload >/dev/null 2>&1 || true
    fi
    exit 0
  fi
  sleep 0.2
done

echo "hyprpaper did not become available" >&2
exit 1
