#!/usr/bin/env bash
set -euo pipefail

# Import Hyprland's per-session Wayland variables before starting/restarting Waybar.
dbus-update-activation-environment --systemd \
  WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE HYPRLAND_INSTANCE_SIGNATURE

exec systemctl --user restart waybar.service
