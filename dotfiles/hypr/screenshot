#!/usr/bin/env bash
set -euo pipefail

mode="${1:-save}"
case "$mode" in
  save|ocr) ;;
  *)
    echo "usage: hypr-screenshot {save|ocr}" >&2
    exit 2
    ;;
esac

# A cancelled slurp selection is a normal action, not a failed screenshot.
geometry="$(slurp)" || exit 0
[[ -n "$geometry" ]] || exit 0

if [[ "$mode" == ocr ]]; then
  grim -g "$geometry" - | tesseract stdin stdout 2>/dev/null | wl-copy
  exit 0
fi

directory="$HOME/Pictures/Screenshots"
mkdir -p "$directory"
timestamp="$(date +%Y-%m-%d_%H-%M-%S)"

# Reserve a unique filename so rapid screenshots never overwrite one another.
output="$(mktemp --tmpdir="$directory" --suffix=.png "${timestamp}_XXXXXX")"
if ! grim -g "$geometry" "$output"; then
  rm -f "$output"
  exit 1
fi

printf 'Screenshot saved: %s\n' "$output"
